# ==============================================================================
# BẢO MẬT & MẬT KHẨU TRUY CẬP TRANG WEB (BẮT BUỘC TRÊN VERCEL)
# ==============================================================================
# Mật khẩu chính để mở khóa truy cập web (Bạn tự đặt mật khẩu riêng của mình)
SITE_PASSWORD=mat-khau-bi-mat-cua-ban

# Secret key ngẫu nhiên dùng để ký HMAC SHA-256 mã hóa cookie phiên đăng nhập
AUTH_SECRET=chuoi-ngau-nhien-dai-va-bi-mat-it-nhat-32-ky-tu

# Khóa khẩn cấp để mở khóa nếu bị spam cố tình nhập sai quá 5 lần (tùy chọn, mặc định sẽ trùng SITE_PASSWORD)
AUTH_UNLOCK_KEY=khoa-mo-khoa-khan-cap-cua-ban

# ==============================================================================
# CẤU HÌNH SUPABASE (TÙY CHỌN - Có thể nhập trực tiếp trong giao diện Cài đặt)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
